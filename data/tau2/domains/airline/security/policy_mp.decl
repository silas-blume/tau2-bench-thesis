bind get_user_details: id, parent_id, user_id, status
bind get_reservation_details: id, parent_id, reservation_id, status
bind search_direct_flight: id, parent_id, origin, destination, date, status
bind search_onestop_flight: id, parent_id, origin, destination, date, status
bind get_flight_status: id, parent_id, flight_number, date, status
bind book_reservation: id, parent_id, user_id, origin, destination, flight_type, cabin, flights, passengers, payment_methods, total_baggages, nonfree_baggages, insurance, status
bind update_reservation_flights: id, parent_id, reservation_id, cabin, flights, payment_id, status
bind update_reservation_baggages: id, parent_id, reservation_id, total_baggages, nonfree_baggages, payment_id, status
bind update_reservation_passengers: id, parent_id, reservation_id, passengers, status
bind cancel_reservation: id, parent_id, reservation_id, status
bind send_certificate: id, parent_id, user_id, amount, status
bind transfer_to_human_agents: id, parent_id, summary, status
bind termination: id, parent_id, termination_reason, termination_initiator
bind message: id, parent_id, sender, receiver, content
bind cognition: id, parent_id, content, cognition_type
flight_type: one_way, round_trip
cabin: basic_economy, economy, business
insurance: yes, no
origin: SFO, JFK, LAX, ORD, DFW, DEN, SEA, ATL, MIA, BOS, PHX, IAH, LAS, MCO, EWR, CLT, MSP, DTW, PHL, LGA
destination: SFO, JFK, LAX, ORD, DFW, DEN, SEA, ATL, MIA, BOS, PHX, IAH, LAS, MCO, EWR, CLT, MSP, DTW, PHL, LGA
total_baggages: integer between 0 and 20
nonfree_baggages: integer between 0 and 20
amount: integer between -10000 and 10000
termination_reason: task_complete, error, user_request, max_iterations
termination_initiator: AGENT, USER, SYSTEM
sender: USER, AGENT, SYSTEM
receiver: USER, AGENT, SYSTEM
cognition_type: PLANNING, REASONING, REFLECTION
