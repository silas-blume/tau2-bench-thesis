<?xml version="1.0" encoding="UTF-8"?>
<dcrgraph title="Airline Agent Policy — Data-Aware (XML_DCR_DATA)">
  <specification>
    <resources>
      <events>
        <event id="get_user_details" description="User details could not be retrieved at this point." />
        <event id="get_reservation_details" description="Reservation details cannot be looked up before user identity is established. Call get_user_details first." />
        <event id="search_direct_flight" description="Direct flight search is not available at this point." />
        <event id="search_onestop_flight" description="One-stop flights cannot be searched before direct flights have been searched. Call search_direct_flight first." />
        <event id="get_flight_status" description="Flight status lookup is not available at this point." />
        <event id="book_reservation" description="Reservation cannot be booked. Ensure: (1) get_user_details called, (2) booking_params_valid confirms &lt;=5 passengers, &lt;=1 credit card, &lt;=3 gift cards, &lt;=1 certificate, (3) booking_payment_methods_valid confirms payment methods are in user profile. Also unavailable after transfer to human agent." />
        <event id="update_reservation_flights" description="Flight/cabin update is blocked. Ensure: (1) get_user_details, get_reservation_details, and get_flight_status called, (2) reservation_has_flown is false, (3) reservation_is_basic_economy is false (for flight changes), (4) update_payment_in_profile confirms payment method is in user profile. Also unavailable after transfer to human agent." />
        <event id="update_reservation_baggages" description="Baggage update is blocked. Ensure: (1) get_user_details and get_reservation_details called, (2) bags_add_only_valid confirms new total &gt;= current. Also unavailable after transfer to human agent." />
        <event id="update_reservation_passengers" description="Passenger update is blocked. Ensure: (1) get_user_details and get_reservation_details called, (2) passenger_count_unchanged_valid confirms the passenger count has not changed. Also unavailable after transfer to human agent." />
        <event id="cancel_reservation" description="Cancellation is blocked. Ensure: (1) get_user_details, get_reservation_details, and get_flight_status called, (2) reservation_has_flown is false, (3) reservation_cancellation_eligible confirms eligibility (business class, airline-cancelled, insured, or booking within 24 h). Also unavailable after transfer to human agent." />
        <event id="send_certificate" description="Certificate cannot be issued. Ensure: (1) get_user_details, get_reservation_details, and get_flight_status called, (2) user_compensation_eligible is true, (3) certificate_amount_valid confirms amount equals $100 x pax (cancelled) or $50 x pax (delayed). Also unavailable after transfer to human agent." />
        <event id="transfer_to_human_agents" description="Transfer to a human agent is not available at this point." />
        <event id="calculate" description="The calculate action is not available at this point." />
        <event id="list_all_airports" description="The list all airports action is not available at this point." />
        <event id="booking_num_passengers" dataType="int" decision="?" description="Provide the number of passengers in the booking request (policy limit: &lt;= 5)." />
        <event id="booking_num_credit_cards" dataType="int" decision="?" description="Provide the number of credit cards in the booking payment methods (policy limit: &lt;= 1)." />
        <event id="booking_num_gift_cards" dataType="int" decision="?" description="Provide the number of gift cards in the booking payment methods (policy limit: &lt;= 3)." />
        <event id="booking_num_certificates" dataType="int" decision="?" description="Provide the number of travel certificates in the booking payment methods (policy limit: &lt;= 1)." />
        <event id="booking_params_valid" dataType="bool" decision="[booking_num_passengers] &lt;= 5 and [booking_num_credit_cards] &lt;= 1 and [booking_num_gift_cards] &lt;= 3 and [booking_num_certificates] &lt;= 1" description="Booking parameter validation failed: check passengers &lt;= 5, credit cards &lt;= 1, gift cards &lt;= 3, travel certificates &lt;= 1." />
        <event id="booking_payment_methods_valid" dataType="bool" decision="?" description="Provide whether all payment methods in the booking are in the user profile. Policy: all payment methods must already be in user profile for safety reasons." />
        <event id="book_reservation_valid" dataType="bool" decision="[booking_params_valid] and [booking_payment_methods_valid]" description="Booking blocked: parameter limits and payment-method profile checks must both pass." />
        <event id="reservation_is_basic_economy" dataType="bool" decision="?" description="Provide whether the reservation cabin class is basic economy." />
        <event id="reservation_has_flown" dataType="bool" decision="?" description="Provide whether any flight in the reservation has already departed/flown." />
        <event id="reservation_cancellation_eligible_base" dataType="bool" decision="?" description="Provide whether the reservation is eligible for cancellation on grounds other than the 24-hour booking window: business class, airline-cancelled flight, or travel insurance with covered reason (health/weather)." />
        <event id="booking_within_24h" dataType="bool" decision="?" description="Provide whether the reservation was made within the last 24 hours. Policy: bookings made within 24 h are eligible for cancellation regardless of class or insurance." />
        <event id="reservation_cancellation_eligible" dataType="bool" decision="[reservation_cancellation_eligible_base] or [booking_within_24h]" description="Cancellation eligibility check failed: reservation must be business class, airline-cancelled, insured with covered reason, or booked within the last 24 hours." />
        <event id="reservation_current_bag_count" dataType="int" decision="?" description="Provide the current total number of checked bags in the reservation." />
        <event id="reservation_num_passengers" dataType="int" decision="?" description="Provide the number of passengers in the reservation." />
        <event id="cancel_reservation_valid" dataType="bool" decision="(not [reservation_has_flown]) and [reservation_cancellation_eligible]" description="Cancellation blocked: reservation must be unflown and eligible for cancellation." />
        <event id="update_payment_in_profile" dataType="bool" decision="?" description="Provide whether the payment method supplied for the flight modification is in the user profile. Policy: payment method must already be in user profile for safety reasons." />
        <event id="update_reservation_flights_valid" dataType="bool" decision="(not [reservation_has_flown]) and (not [reservation_is_basic_economy]) and [update_payment_in_profile]" description="Flight/cabin update blocked: reservation must be unflown, not basic economy, and the payment method must be in the user profile." />
        <event id="new_total_baggages" dataType="int" decision="?" description="Provide the requested new total number of checked bags." />
        <event id="bags_add_only_valid" dataType="bool" decision="[new_total_baggages] &gt;= [reservation_current_bag_count]" description="Baggage update validation failed: new total bag count must be &gt;= current count. Bags can only be added, not removed." />
        <event id="update_num_passengers" dataType="int" decision="?" description="Provide the number of passengers in the passenger-update request." />
        <event id="passenger_count_unchanged_valid" dataType="bool" decision="[update_num_passengers] == [reservation_num_passengers]" description="Passenger update validation failed: the number of passengers cannot be changed. Submitted count must equal current reservation count." />
        <event id="user_compensation_eligible" dataType="bool" decision="?" description="Provide whether the user is eligible for compensation (silver/gold member, travel insurance holder, or business-class passenger). Regular members without insurance flying economy/basic-economy are not eligible." />
        <event id="certificate_amount_valid" dataType="bool" decision="?" description="Provide whether the certificate amount is valid: $100 x passengers for any of the user's reservations with a cancelled flight, or $50 x passengers for any with a delayed flight." />
        <event id="send_certificate_valid" dataType="bool" decision="[user_compensation_eligible] and [certificate_amount_valid]" description="Certificate blocked: user must be compensation-eligible and the amount must be valid." />
      </events>
