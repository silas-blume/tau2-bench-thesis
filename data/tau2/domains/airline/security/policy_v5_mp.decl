Precedence[get_reservation_details, update_reservation_passengers] |  | T.reservation_id == A.reservation_id | 
Precedence[get_reservation_details, cancel_reservation] |  | T.reservation_id == A.reservation_id | 
Absence[update_reservation_flights] | reservation_cabin(A.reservation_id) == 'basic_economy' and flights_changed(A.reservation_id, A.flights) | 
Absence[update_reservation_flights] | has_flown_flights(A.reservation_id) | 
Absence[update_reservation_flights] | route_changed(A.reservation_id, A.flights) | 
Absence[update_reservation_flights] | not payment_in_profile(A.payment_id, reservation_user_id(A.reservation_id)) | 
Absence[update_reservation_flights] | not payment_method_type_ok(A.payment_id) | 
Not Response[get_reservation_details, update_reservation_baggages] |  | T.reservation_id == A.reservation_id and T.total_baggages < A.total_baggages | 
Not Response[get_reservation_details, update_reservation_passengers] |  | T.reservation_id == A.reservation_id and count_items(T.passengers) != count_items(A.passengers) | 
Precedence[get_user_details, get_reservation_details] |  | T.user_id == A.user_id | 
Absence[update_reservation_baggages] | A.total_baggages < 0 | 
Absence[update_reservation_baggages] | A.nonfree_baggages < 0 | 
Absence[update_reservation_baggages] | A.nonfree_baggages > A.total_baggages | 
