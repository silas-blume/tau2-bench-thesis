termination_reason: task_complete, error, user_request, max_iterations
termination_initiator: AGENT, USER, SYSTEM
sender: USER, AGENT, SYSTEM
receiver: USER, AGENT, SYSTEM
cognition_type: PLANNING, REASONING, REFLECTION
Precedence[get_user_details, book_reservation] |  | A.user_id == T.user_id | 
Absence[book_reservation] | count_items(A.passengers) > 5 | 
Absence[book_reservation] | not pass_info_complete(A.passengers) | 
Absence[book_reservation] | count_credit_cards(A.payment_methods) > 1 | 
Absence[book_reservation] | count_gift_cards(A.payment_methods) > 3 | 
Absence[book_reservation] | count_certificates(A.payment_methods) > 1 | 
Absence[book_reservation] | has_unknown_payment(A.payment_methods, A.user_id) | 
Not Response[get_user_details, book_reservation] | A.membership == 'regular' | T.user_id == A.user_id and T.cabin == 'basic_economy' and T.total_baggages - T.nonfree_baggages > 0 * count_items(T.passengers) | 
Not Response[get_user_details, book_reservation] | A.membership == 'regular' | T.user_id == A.user_id and T.cabin == 'economy' and T.total_baggages - T.nonfree_baggages > 1 * count_items(T.passengers) | 
Not Response[get_user_details, book_reservation] | A.membership == 'regular' | T.user_id == A.user_id and T.cabin == 'business' and T.total_baggages - T.nonfree_baggages > 2 * count_items(T.passengers) | 
Not Response[get_user_details, book_reservation] | A.membership == 'silver' | T.user_id == A.user_id and T.cabin == 'basic_economy' and T.total_baggages - T.nonfree_baggages > 1 * count_items(T.passengers) | 
Not Response[get_user_details, book_reservation] | A.membership == 'silver' | T.user_id == A.user_id and T.cabin == 'economy' and T.total_baggages - T.nonfree_baggages > 2 * count_items(T.passengers) | 
Not Response[get_user_details, book_reservation] | A.membership == 'silver' | T.user_id == A.user_id and T.cabin == 'business' and T.total_baggages - T.nonfree_baggages > 3 * count_items(T.passengers) | 
Not Response[get_user_details, book_reservation] | A.membership == 'gold' | T.user_id == A.user_id and T.cabin == 'basic_economy' and T.total_baggages - T.nonfree_baggages > 2 * count_items(T.passengers) | 
Not Response[get_user_details, book_reservation] | A.membership == 'gold' | T.user_id == A.user_id and T.cabin == 'economy' and T.total_baggages - T.nonfree_baggages > 3 * count_items(T.passengers) | 
Not Response[get_user_details, book_reservation] | A.membership == 'gold' | T.user_id == A.user_id and T.cabin == 'business' and T.total_baggages - T.nonfree_baggages > 4 * count_items(T.passengers) | 
Precedence[search_direct_flight, search_onestop_flight] |  |  | 
Absence[search_direct_flight] | A.origin == A.destination | 
Absence[search_onestop_flight] | A.origin == A.destination | 
Absence[book_reservation] | A.origin == A.destination | 
Absence[book_reservation] | A.nonfree_baggages > A.total_baggages | 
Absence[book_reservation] | A.total_baggages < 0 | 
Absence[book_reservation] | A.nonfree_baggages < 0 | 
Absence[book_reservation] | not all_flights_available(A.flights) | 
