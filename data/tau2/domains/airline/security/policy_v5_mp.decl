Absence[cancel_reservation] | not cancellation_eligible(A.reservation_id) | 
Precedence[get_user_details, send_certificate] |  | A.user_id == T.user_id | 
Absence[send_certificate] | not compensation_eligible(A.user_id) | 
Absence[send_certificate] | not valid_certificate_amount(A.user_id, A.amount) | 
Precedence[get_flight_status, send_certificate] |  |  | 
Absence[send_certificate] | A.amount <= 0 | 
Absence[send_certificate] | A.amount > 500 | 
