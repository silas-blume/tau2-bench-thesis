<dcrgraph title="Airline Agent Policy">
  <!--
    Encoding of the Airline Agent Policy into standard DCR (XML_DCR_PORTAL format).

    Encodable rules (structural/sequencing constraints only):
      - Identity must be established before any booking, lookup, modification, cancellation, or compensation
      - Reservation details must be fetched before modifying, cancelling, or issuing compensation
      - Flight status must be confirmed before modifying flights, cancelling, or issuing a compensation certificate
      - Direct flights must be searched before one-stop alternatives
      - Transfer to human agent is terminal: disables all write actions

    Not encodable in standard DCR (require data-aware DCR / YAML predicates):
      - Max 5 passengers per reservation
      - At most 1 credit card, 3 gift cards, 1 travel certificate per booking
      - Payment methods must be in user profile
      - Basic economy reservations cannot have flights modified (cabin change still allowed)
      - Route (origin/destination/trip type) cannot change on flight update
      - Baggage can only be added, not removed
      - Passenger count cannot be changed
      - No cancellation/cabin-change if any flight already flown
      - Cancellation eligibility (business class, airline-cancelled, insurance, 24h window)
      - Compensation eligibility (silver/gold member, travel insurance, business class)
      - Certificate amount validation ($100/pax for cancellation, $50/pax for delay)
  -->

  <specification>
    <resources>

      <events>
        <!-- Identity and lookup -->
        <event id="get_user_details"
               description="User details could not be retrieved at this point."/>
        <event id="get_reservation_details"
               description="Reservation details cannot be looked up before user identity is established. Call get_user_details first."/>
        <!-- Search -->
        <event id="search_direct_flight"
               description="Direct flight search is not available at this point."/>
        <event id="search_onestop_flight"
               description="One-stop flights cannot be searched before direct flights have been searched. Call search_direct_flight first."/>
        <event id="get_flight_status"
               description="Flight status lookup is not available at this point."/>
        <!-- Booking -->
        <event id="book_reservation"
               description="A reservation cannot be booked before user identity is established. Call get_user_details first. This action is also unavailable after transfer to a human agent."/>
        <!-- Modifications -->
        <event id="update_reservation_flights"
               description="Flight modifications require user identity and reservation details to be retrieved first (call get_user_details and get_reservation_details). This action is also unavailable after transfer to a human agent."/>
        <event id="update_reservation_baggages"
               description="Baggage updates require user identity and reservation details to be retrieved first (call get_user_details and get_reservation_details). This action is also unavailable after transfer to a human agent."/>
        <event id="update_reservation_passengers"
               description="Passenger updates require user identity and reservation details to be retrieved first (call get_user_details and get_reservation_details). This action is also unavailable after transfer to a human agent."/>
        <!-- Cancellation -->
        <event id="cancel_reservation"
               description="A reservation cannot be cancelled before user identity and reservation details are retrieved (call get_user_details and get_reservation_details). This action is also unavailable after transfer to a human agent."/>
        <!-- Compensation -->
        <event id="send_certificate"
               description="A compensation certificate cannot be issued before user identity is established and flight status is confirmed (call get_user_details and get_flight_status). This action is also unavailable after transfer to a human agent."/>
        <!-- Transfer -->
        <event id="transfer_to_human_agents"
               description="Transfer to a human agent is not available at this point."/>
        <!-- Utility -->
        <event id="calculate"
               description="The calculate action is not available at this point."/>
        <event id="list_all_airports"
               description="The list all airports action is not available at this point."/>
      </events>

      <labels>
        <label id="get_user_details"/>
        <label id="get_reservation_details"/>
        <label id="search_direct_flight"/>
        <label id="search_onestop_flight"/>
        <label id="get_flight_status"/>
        <label id="book_reservation"/>
        <label id="update_reservation_flights"/>
        <label id="update_reservation_baggages"/>
        <label id="update_reservation_passengers"/>
        <label id="cancel_reservation"/>
        <label id="send_certificate"/>
        <label id="transfer_to_human_agents"/>
        <label id="calculate"/>
        <label id="list_all_airports"/>
      </labels>

      <labelMappings>
        <labelMapping eventId="get_user_details"            labelId="get_user_details"/>
        <labelMapping eventId="get_reservation_details"     labelId="get_reservation_details"/>
        <labelMapping eventId="search_direct_flight"        labelId="search_direct_flight"/>
        <labelMapping eventId="search_onestop_flight"       labelId="search_onestop_flight"/>
        <labelMapping eventId="get_flight_status"           labelId="get_flight_status"/>
        <labelMapping eventId="book_reservation"            labelId="book_reservation"/>
        <labelMapping eventId="update_reservation_flights"  labelId="update_reservation_flights"/>
        <labelMapping eventId="update_reservation_baggages" labelId="update_reservation_baggages"/>
        <labelMapping eventId="update_reservation_passengers" labelId="update_reservation_passengers"/>
        <labelMapping eventId="cancel_reservation"          labelId="cancel_reservation"/>
        <labelMapping eventId="send_certificate"            labelId="send_certificate"/>
        <labelMapping eventId="transfer_to_human_agents"    labelId="transfer_to_human_agents"/>
        <labelMapping eventId="calculate"                   labelId="calculate"/>
        <labelMapping eventId="list_all_airports"           labelId="list_all_airports"/>
      </labelMappings>

    </resources>

    <constraints>

      <conditions>
        <!--
          Identity before booking:
          Policy: "The agent must first obtain the user id from the user."
          Rule: user-before-booking (Precedence in YAML)
        -->
        <condition sourceId="get_user_details" targetId="book_reservation"/>

        <!--
          Identity before reservation lookup:
          Policy: "The user must provide their user id."
          Rule: user-before-reservation-lookup (Precedence in YAML)
        -->
        <condition sourceId="get_user_details" targetId="get_reservation_details"/>

        <!--
          Identity before flight modification:
          Policy: "First, the agent must obtain the user id and reservation id."
          Rule: user-before-flight-update (Precedence in YAML)
        -->
        <condition sourceId="get_user_details" targetId="update_reservation_flights"/>

        <!--
          Identity before baggage update:
          Policy: "First, the agent must obtain the user id and reservation id."
          Rule: user-before-baggage-update (Precedence in YAML)
        -->
        <condition sourceId="get_user_details" targetId="update_reservation_baggages"/>

        <!--
          Identity before passenger update:
          Policy: "First, the agent must obtain the user id and reservation id."
          Rule: user-before-passenger-update (Precedence in YAML)
        -->
        <condition sourceId="get_user_details" targetId="update_reservation_passengers"/>

        <!--
          Identity before cancellation:
          Policy: "First, the agent must obtain the user id and reservation id."
          Rule: user-before-cancellation (Precedence in YAML)
        -->
        <condition sourceId="get_user_details" targetId="cancel_reservation"/>

        <!--
          Identity before compensation:
          Policy: "Always confirms the facts before offering compensation."
          Rule: user-before-compensation (Precedence in YAML)
        -->
        <condition sourceId="get_user_details" targetId="send_certificate"/>

        <!--
          Reservation lookup before flight modification:
          Policy: "If the user doesn't know their reservation id, the agent should help locate it."
          Rule: reservation-before-flight-update (Precedence in YAML)
        -->
        <condition sourceId="get_reservation_details" targetId="update_reservation_flights"/>

        <!--
          Reservation lookup before baggage update:
          Rule: reservation-before-baggage-update (Precedence in YAML)
        -->
        <condition sourceId="get_reservation_details" targetId="update_reservation_baggages"/>

        <!--
          Reservation lookup before passenger update:
          Rule: reservation-before-passenger-update (Precedence in YAML)
        -->
        <condition sourceId="get_reservation_details" targetId="update_reservation_passengers"/>

        <!--
          Reservation lookup before cancellation:
          Policy: "If the user doesn't know their reservation id, the agent should help locate it."
          Rule: reservation-before-cancellation (Precedence in YAML)
        -->
        <condition sourceId="get_reservation_details" targetId="cancel_reservation"/>

        <!--
          Flight status confirmation before compensation:
          Policy: "agent can offer a certificate as a gesture after confirming the facts"
          Rule: flight-status-before-certificate (Precedence in YAML)
        -->
        <condition sourceId="get_flight_status" targetId="send_certificate"/>

        <!--
          Flight status check before flight modification:
          Policy: "Cabin cannot be changed if any flight in the reservation has already been flown."
          The agent must call get_flight_status to determine flown status before modifying.
          Rule: flight-status-before-flight-update
        -->
        <condition sourceId="get_flight_status" targetId="update_reservation_flights"/>

        <!--
          Flight status check before cancellation:
          Policy: "If any portion of the flight has already been flown, the agent cannot help
                   and transfer is needed."
          The agent must call get_flight_status to determine flown status before cancelling.
          Rule: flight-status-before-cancellation
        -->
        <condition sourceId="get_flight_status" targetId="cancel_reservation"/>

        <!--
          Reservation details before compensation:
          Policy: "Always confirms the facts before offering compensation."
          The agent needs reservation details (passenger count, cabin, insurance) to determine
          eligibility and the correct certificate amount.
          Rule: reservation-before-compensation
        -->
        <condition sourceId="get_reservation_details" targetId="send_certificate"/>

        <!--
          Direct flight search before one-stop search:
          Policy: Prefer direct flights; search direct before one-stop alternatives.
          Rule: search-direct-before-onestop (Precedence in YAML)
        -->
        <condition sourceId="search_direct_flight" targetId="search_onestop_flight"/>
      </conditions>

      <excludes>
        <!--
          Transfer to human agent is terminal — no booking after transfer.
          Policy: "transfer the user to a human agent if and only if the request
                   cannot be handled within the scope of your actions"
          Rule: no-booking-after-transfer (Not Response in YAML)
        -->
        <exclude sourceId="transfer_to_human_agents" targetId="book_reservation"/>

        <!--
          No flight modification after transfer.
          Rule: no-flight-update-after-transfer (Not Response in YAML)
        -->
        <exclude sourceId="transfer_to_human_agents" targetId="update_reservation_flights"/>

        <!--
          No baggage update after transfer.
          Rule: no-baggage-update-after-transfer (Not Response in YAML)
        -->
        <exclude sourceId="transfer_to_human_agents" targetId="update_reservation_baggages"/>

        <!--
          No passenger update after transfer.
          Rule: no-passenger-update-after-transfer (Not Response in YAML)
        -->
        <exclude sourceId="transfer_to_human_agents" targetId="update_reservation_passengers"/>

        <!--
          No cancellation after transfer.
          Rule: no-cancellation-after-transfer (Not Response in YAML)
        -->
        <exclude sourceId="transfer_to_human_agents" targetId="cancel_reservation"/>

        <!--
          No compensation after transfer.
          Rule: no-compensation-after-transfer (Not Response in YAML)
        -->
        <exclude sourceId="transfer_to_human_agents" targetId="send_certificate"/>
      </excludes>

    </constraints>
  </specification>

  <runtime>
    <marking>
      <!-- No events have been executed at the start of a session -->
      <executed/>
      <!-- All events are available at the start; excludes fire dynamically -->
      <included>
        <event id="get_user_details"/>
        <event id="get_reservation_details"/>
        <event id="search_direct_flight"/>
        <event id="search_onestop_flight"/>
        <event id="get_flight_status"/>
        <event id="book_reservation"/>
        <event id="update_reservation_flights"/>
        <event id="update_reservation_baggages"/>
        <event id="update_reservation_passengers"/>
        <event id="cancel_reservation"/>
        <event id="send_certificate"/>
        <event id="transfer_to_human_agents"/>
        <event id="calculate"/>
        <event id="list_all_airports"/>
      </included>
      <!-- No pending obligations at session start -->
      <pendingResponses/>
    </marking>
  </runtime>

</dcrgraph>
